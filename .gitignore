# .NET
[Bb]in/
# Rust Cargo [[bin]] sources live under src/bin/ — not .NET build output.
!**/src/bin/
!**/src/bin/**
[Oo]bj/
[Ll]og/
[Ll]ogs/
.vs/
*.user
*.userosscache
*.suo
*.cache
*.ncrunch*
_ReSharper*/
*.DotSettings.user

# Node / JS monorepo
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Next.js (apps/Web)
.next/
out/

# Expo / React Native (apps/Mobile)
.expo/
.metro-health-check*
**/android/
**/ios/
# Local Expo native modules must stay in git (not prebuild output).
!apps/Mobile/modules/*/android/
!apps/Mobile/modules/*/android/**
apps/Mobile/modules/*/android/build/
apps/Mobile/modules/*/android/.gradle/
.kotlin/

# Environment — never commit secrets; examples are ok
.env
.env.local
.env.*.local
!.env.example

# Secrets / local-only config (never commit; *.example.* templates are ok)
# All machine-local files live under /local/ (not in remote).
/local/
# Legacy locations (pre-Local/); keep ignored if recreated at root
.flora/
appsettings.Local.json
appsettings.Production.json
appsettings.*.Local.json
Flora.API/cursor-temp-bootstrap.sql
SECRETS-ROTATION.local.md
# App-update broadcast (prod): scripts/broadcast.env.example is committed
scripts/broadcast.env
scripts/broadcast.env.local
**/flora-broadcast-token-once.txt
!scripts/broadcast.env.example
*.secrets.local.*

# Firebase Admin SDK / any real service-account creds (local API push) — keep only *.example
Flora.API/secrets/*
!Flora.API/secrets/*.example
!Flora.API/secrets/*.example.*
backend/secrets/*
!backend/secrets/*.example
!backend/secrets/*.example.*

# Build / test artifacts (keep contract-fixtures for CI clones)
artifacts/*
!artifacts/contract-fixtures/
!artifacts/contract-fixtures/**
.tmp-build-check/
.tmp-apk-inspect/
apps/Web/.tmp-feed-compact-scroll/
.expo-export-test/
**/.expo-export-test/
**/android_gen/
**/.prebuild-stage*/
**/dist/
**/vendor/

# OS / editors
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/

# Rust (workspace root Cargo.toml → ./target via .cargo/config.toml)
/target/
# Custom CARGO_TARGET_DIR for A/B benches (target-v79-*, target-v710-*, …)
/target-*/
backend/Target/
backend/target/
**/Cargo.toml.orig
apps/Web/public/frc/*.wasm
apps/Mobile/modules/flora-frc-i/android/src/main/jniLibs/
apps/Mobile/modules/flora-frc-i/ios/lib/

# Python bytecode (compete/audit probes)
**/__pycache__/
*.pyc

# FRC-V polygon (кросс-кодек арена): клипы, отчёты и рабочие файлы прогонов
polygon-clips/
polygon-out*/
polygon-*.log
# Кэш бинарей энкодера для A/B-итераций (--reuse): локальный, не в remote
.polygon-bin/
