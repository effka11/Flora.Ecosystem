{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@flora/fscp": ["../../Products/FSCP/ts/src/index.ts"],
      "@flora/fscp/*": ["../../Products/FSCP/ts/src/*"]
    }
  },
  "include": ["src/**/*.ts", "../../Products/FSCP/ts/src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "../../Products/FSCP/ts/src/**/*.test.ts"]
}
