// Zed tasks — зеркало .vscode/tasks.json (+ проверки)
// dependsOn в Zed не поддерживается — composite-задачи запускай по шагам
// Запуск: task: spawn (Ctrl+Shift+T) или Alt+Shift+T
[
  {
    "label": "Flora: API + Web dev localhost (Zed)",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/zed-dev-api-web.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Flora DB: start (Docker)",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-Command",
      "docker compose up -d; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $deadline = (Get-Date).AddSeconds(90); do { $status = docker inspect -f '{{.State.Health.Status}}' flora-local-postgres 2>$null; if ($status -eq 'healthy') { Write-Host 'PostgreSQL ready (flora-local-postgres).'; exit 0 }; if ($status -eq 'unhealthy') { Write-Error 'flora-local-postgres is unhealthy.' }; Start-Sleep -Seconds 2 } while ((Get-Date) -lt $deadline); Write-Error 'PostgreSQL did not become healthy in time. Is Docker Desktop running?'"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "no_focus"
  },
  {
    "label": "Flora dev: stop conflicting processes (API)",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/stop-dev-localhost.ps1",
      "-Api"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "no_focus"
  },
  {
    "label": "Flora API: Rust localhost",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/run-rust-gateway-localhost.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always"
  },
  {
    "label": "Flora API: Rust localhost (silent)",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/run-rust-gateway-localhost.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "no_focus"
  },
  {
    "label": "Flora Gateway: Rust localhost",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/run-rust-gateway-localhost.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always"
  },
  {
    "label": "Flora API: dev localhost",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-Command",
      "Write-Host 'Strangler local: start «Flora API: .NET upstream» then «Flora Gateway: Rust», or one-shot «Flora: API + Web».'; exit 0"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Flora API: dev localhost (silent)",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/run-rust-gateway-localhost.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "no_focus"
  },
  {
    "label": "Flora: dev localhost",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/web-dev-localhost.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always"
  },
  {
    "label": "Flora: dev offline demo (dev-token, no API)",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-Command",
      "$env:NEXT_PUBLIC_DEV_AUTO_AUTH='1'; npm run dev"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/Apps/Web",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "Flora Social: publish to VPS (full)",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/deploy-flora-social-from-task.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Flora Android: debug (USB)",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/mobile-debug-android.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Flora Android: release APK",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/mobile-release-android.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/Apps/Mobile",
    "reveal": "always"
  },
  {
    "label": "Flora Android: release APK + publish GitHub",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/mobile-release-android.ps1",
      "-PublishGitHub"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/Apps/Mobile",
    "reveal": "always"
  },
  {
    "label": "Flora Social: Send auto-update & notifications to side-APK",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/send-apk-auto-update.ps1",
      "-Production",
      "-Confirm"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "description": "Prod: inbox + data-only HIGH FCM app_update with update{} for all Android sideload clients (same wire as one-user smoke). Requires GitHub social/v{VERSION} + flora-api with send_app_update_push."
  },
  {
    "label": "Flora: send auto-update (local)",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/send-apk-auto-update.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "FLORA_API_URL": "http://localhost:5290",
      "FLORA_ADMIN_BROADCAST_TOKEN": "dev-local-broadcast-token-change-me"
    },
    "reveal": "always"
  },
  {
    "label": "Flora Android: install release APK",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/mobile-install-release-android.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/Apps/Mobile",
    "reveal": "always"
  },
  {
    "label": "Flora: broadcast app-update (local)",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/broadcast-app-update.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "FLORA_API_URL": "http://localhost:5290",
      "FLORA_ADMIN_BROADCAST_TOKEN": "dev-local-broadcast-token-change-me"
    },
    "reveal": "always"
  },
  {
    "label": "Flora: broadcast app-update (production)",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/broadcast-app-update.ps1",
      "-Production",
      "-Confirm"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Flora: setup app-update broadcast (prod check)",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/Scripts/setup-app-update-broadcast.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "dotnet build",
    "command": "dotnet",
    "args": ["build", "Flora.Ecosystem.slnx"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "dotnet test",
    "command": "dotnet",
    "args": ["test", "Flora.Ecosystem.slnx"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "npm: typecheck (все workspaces)",
    "command": "npm",
    "args": ["run", "typecheck"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "npm: lint",
    "command": "npm",
    "args": ["run", "lint"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "npm: ci (typecheck + lint + test)",
    "command": "npm",
    "args": ["run", "ci"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  }
]
