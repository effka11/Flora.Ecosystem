# Copy to .env before release/EAS builds (file is gitignored).
#
# REST through Cloudflare (orange social.*). Do not use origin.* for the
# release API URL: that bypasses the CDN (Selectel used to block PUT; CF does not).
# Keep origin.* grey for Web SSE. Gov Next is already on Cloudflare (gov.*) —
# set EXPO_PUBLIC_GOV_URL now; point a Gov client at gov.* when flora-gov :3001 is up.
EXPO_PUBLIC_API_URL=https://social.flora-s.net
EXPO_PUBLIC_GOV_URL=https://gov.flora-s.net
EXPO_PUBLIC_ORIGIN_URL=https://origin.flora-s.net
# EXPO_PUBLIC_SENTRY_DSN=
