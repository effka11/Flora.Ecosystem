# Agent lethal-triad hardening: block Read/@ access to secrets.
# Shell/MCP bypass is gated by .cursor/hooks (see security.md).
# Do NOT ignore all of local/ - worktrees/diagnostics stay reachable.

local/**/*.secret
local/.flora/**
local/**/SECRETS*
SECRETS-ROTATION.local.md

**/.env
**/.env.*
!.env.example
!**/.env.example
!**/.env*.example

scripts/broadcast.env
scripts/broadcast.env.local

backend/secrets/**
**/credentials.json
**/*.pem
**/*service-account*.json