<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!--
    Install permissions are added only by Apps/Mobile/plugins/withFloraApkUpdater.js
    for sideload builds. Keep them out of this module manifest so Play/EAS AAB
    (FLORA_DISABLE_SIDELOAD_UPDATES=1) does not pick up REQUEST_INSTALL_PACKAGES via merge.
  -->
  <application>
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.flora.apk.provider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/flora_apk_file_paths" />
    </provider>

    <provider
      android:name=".FloraApkUpdaterInitProvider"
      android:authorities="${applicationId}.flora.apk.updater.init"
      android:exported="false"
      android:initOrder="100" />

    <receiver
      android:name=".FloraApkInstallReceiver"
      android:exported="false" />

    <!-- exported: DownloadManager (system) delivers ACTION_DOWNLOAD_COMPLETE -->
    <receiver
      android:name=".FloraDownloadCompleteReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
      </intent-filter>
    </receiver>

    <!--
      Config plugins run at prebuild and cannot see Expo's library service.
      Remove Expo FMS at Gradle merge time so only our wrapper gets MESSAGING_EVENT.
    -->
    <service
      android:name="expo.modules.notifications.service.ExpoFirebaseMessagingService"
      tools:node="remove" />

    <service
      android:name=".FloraAppUpdateMessagingService"
      android:exported="false">
      <intent-filter android:priority="1000">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
